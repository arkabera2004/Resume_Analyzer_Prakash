MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB_NAME=resume_analyzer
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
